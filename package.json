{
  "name": "wafra-farm-app-mockup",
  "version": "1.5.7",
  "private": true,
  "description": "Interactive UI mockup of the Wafra Farm app, v1.5.7, built against Build Specification v1.7. No build step: index.html plus ES modules.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "check": "./tools/syntax.sh",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/smoke.mjs --shots .shots",
    "catalogue": "node tools/smoke.mjs --dump app/i18n/source/en.json",
    "i18n": "python3 tools/build-i18n.py",
    "fixtures": "python3 tools/json-to-module.py",
    "deck": "node tools/screendeck.mjs",
    "changelog": "node tools/changelog.mjs",
    "icons": "node tools/build-icons.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "lucide-static": "^1.34.0"
  }
}
