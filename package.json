{
  "name": "wafra-farm-app-mockup",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive UI mockup of the Wafra white-label farm management app (Build Specification v1.1). No build step: index.html plus ES modules.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "check": "./tools/syntax.sh",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/smoke.mjs --shots .shots",
    "catalogue": "node tools/smoke.mjs --dump app/i18n/source/en.json",
    "i18n": "python3 tools/build-i18n.py",
    "fixtures": "python3 tools/json-to-module.py"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
