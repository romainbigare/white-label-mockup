rules_version = '2';

// Wafra Farm App — Firestore rules. Owned by Wafra. See docs/service-architecture/
// (the fields are in FIRESTORE_SCHEMA.md).
//
// Wafra's Firestore holds all client data. Writers: the app (through these
// rules), Wafra's functions (Admin SDK, which bypasses these rules) and Wafra
// staff (admin claim). The analytics provider has no login here: Wafra's
// functions push farm changes to it and receive its survey results.
// RevenueCat has none either: it calls revenueCatWebhook. farmService is the
// only record of which farms are paid for.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Wafra staff.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function farm(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data;
    }

    // farmAccess/{uid}_{farmId}
    function accessPath(farmId) {
      return /databases/$(database)/documents/farmAccess/$(request.auth.uid + '_' + farmId);
    }

    function isOwner(farmId) {
      return signedIn() && farm(farmId).ownerUid == request.auth.uid;
    }

    function hasAccess(farmId) {
      return signedIn() && exists(accessPath(farmId))
        && get(accessPath(farmId)).data.status == 'active';
    }

    // Owner, co-owner or supervisor.
    function isMember(farmId) {
      return isOwner(farmId) || hasAccess(farmId);
    }

    // Owner or co-owner.
    function isOwnerLike(farmId) {
      return isOwner(farmId)
        || (hasAccess(farmId) && get(accessPath(farmId)).data.role == 'co-owner');
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The farm's outline and the fields inside it, saved together: at least one field.
    function boundaryOk(b) {
      return b.points is list && b.points.size() >= 3
        && b.fields is list && b.fields.size() >= 1 && b.fields.size() <= 100;
    }

    // A new boundary is the next version, so each survey matches one version.
    function boundaryStepOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['boundary'])
        || (request.resource.data.boundary.version == resource.data.boundary.version + 1
            && boundaryOk(request.resource.data.boundary));
    }

    // The app may archive a farm, never bring one back.
    function statusStepOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || request.resource.data.status == 'archived';
    }

    // -- people ---------------------------------------------------------------

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['firstName', 'lastName', 'email', 'phone', 'preferences', 'createdAt', 'updatedAt'])
        && request.resource.data.phone == request.auth.token.phone_number;

      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['firstName', 'lastName', 'email', 'preferences', 'updatedAt']);

      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // -- farms ----------------------------------------------------------------

    match /farms/{farmId} {
      // resource.data (not a get) so that "my farms" queries pass the rules.
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || hasAccess(farmId);

      // The creator becomes the owner. Contract farms are created by Wafra's
      // functions (from contractFarms), never by the app.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['ownerUid', 'name', 'nameAr', 'type', 'country', 'region', 'location', 'boundary',
              'fieldNames', 'adviceRules', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.boundary.version == 1
        && boundaryOk(request.resource.data.boundary);

      // Owner and co-owners edit the farm (and rename fields: fieldNames, with
      // no new boundary version); supervisors only redraw boundaries. What the
      // provider measured (providerFarmId, surveyStatus, cropAreaHa, treeCount,
      // …) and the contract are written only by Wafra's functions: the price
      // comes from them, and the farm pass trusts providerFarmId.
      allow update: if boundaryStepOk() && statusStepOk() && (
          (isOwnerLike(farmId)
            && onlyChanges(['name', 'nameAr', 'type', 'country', 'region', 'location', 'boundary',
                            'fieldNames', 'adviceRules', 'status', 'updatedAt']))
          || (hasAccess(farmId) && onlyChanges(['boundary', 'updatedAt'])));

      allow delete: if false;

      match /contacts/{contactId} {
        allow read: if isAdmin() || isMember(farmId);
        allow write: if isOwnerLike(farmId);
      }
    }

    function inviteAt(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }

    // An unused, unexpired invitation for this farm and role.
    function inviteOpen(code, farmId, role) {
      return inviteAt(code).farmId == farmId && inviteAt(code).role == role
        && inviteAt(code).get('usedBy', null) == null && inviteAt(code).expiresAt > request.time;
    }

    // Roles. The person invited creates their own record with a valid code;
    // the owner or a co-owner may revoke it.
    match /farmAccess/{accessId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || isOwnerLike(resource.data.farmId);
      allow create: if signedIn()
        && accessId == request.auth.uid + '_' + request.resource.data.farmId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.ownerUid == farm(request.resource.data.farmId).ownerUid
        && inviteOpen(request.resource.data.inviteCode, request.resource.data.farmId, request.resource.data.role)
        && request.resource.data.keys().hasOnly(
             ['uid', 'farmId', 'ownerUid', 'role', 'status', 'inviteCode', 'grantedBy', 'grantedAt', 'revokedAt']);
      allow update: if isOwnerLike(resource.data.farmId)
        && onlyChanges(['status', 'revokedAt'])
        && request.resource.data.status == 'revoked';
      allow delete: if false;
    }

    // Invitations. Anyone signed in can look one up by its code (to join); the
    // person joining marks it used.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow update: if signedIn()
        && resource.data.get('usedBy', null) == null && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && onlyChanges(['usedBy', 'usedAt']);
      allow create: if isOwnerLike(request.resource.data.farmId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerUid == farm(request.resource.data.farmId).ownerUid
        && request.resource.data.role in ['co-owner', 'supervisor']
        && request.resource.data.keys().hasOnly(
             ['farmId', 'ownerUid', 'role', 'createdBy', 'createdAt', 'expiresAt']);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // -- payment --------------------------------------------------------------

    // The centre: one record per measured farm (active, readonly or removed),
    // written only by keepActiveFarms.
    match /farmService/{farmId} {
      allow get: if isAdmin() || isMember(farmId);
      allow list: if isAdmin();
      allow write: if false;
    }

    // RevenueCat's copy of a buyer's purchases (written by revenueCatWebhook).
    match /customers/{uid}/{document=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // The price table the app shows: bands, VAT and limits, never a rate.
    match /pricing/current {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // The rates. Staff only: the app asks quotePrice for its band.
    match /pricing/rates {
      allow read, write: if isAdmin();
    }

    // Contracts: anyone signed in may fetch one by its random ID; prices and
    // invoices sit in the private sub-document.
    match /contracts/{contractId} {
      allow get: if signedIn();
      allow list, write: if isAdmin();

      match /private/{doc} {
        allow read, write: if isAdmin();
      }
    }

    // Contract farms, keyed by the owner's E.164 phone number. Wafra's
    // functions create the farms from it for their owner. A person can fetch
    // only their own entry; nobody can list.
    match /contractFarms/{phone} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.phone_number == phone);
      allow list, write: if isAdmin();
    }

    // -- advice log -----------------------------------------------------------

    // Each advice or weather warning from the provider, written by Wafra's
    // functions (providerEvents). The app records what people do with it,
    // and every time it is sent on.
    match /suggestions/{suggestionId} {
      allow read: if isAdmin() || isMember(resource.data.farmId);
      allow create: if false;
      allow update: if isMember(resource.data.farmId)
        && onlyChanges(['status', 'seenAt', 'deferredUntil', 'completedAt', 'completedBy',
                        'assignedTo', 'shareCount', 'lastSharedAt'])
        && request.resource.data.status in ['open', 'deferred', 'completed'];
      allow delete: if false;

      match /shares/{shareId} {
        allow read: if isAdmin() || isMember(resource.data.farmId);
        allow create: if isMember(request.resource.data.farmId);
        allow update, delete: if false;
      }
    }

    // -- feedback -------------------------------------------------------------

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'farmId', 'type', 'message', 'appVersion', 'platform', 'lang', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && (!('farmId' in request.resource.data) || isMember(request.resource.data.farmId))
        && request.resource.data.type in ['bug', 'idea', 'question']
        && request.resource.data.status == 'new'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
