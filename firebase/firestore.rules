rules_version = '2';

// Wafra Farm App — Firestore rules for schema v1 (see SCHEMA.md and
// ACCOUNTS_ROLES_BILLING.md).
//
// Wafra's database is a light mirror of MMC's, plus Wafra's prices and
// contracts (see docs/PRICING_STRATEGY.md). MMC's sync uses the Admin SDK and
// bypasses these rules. Wafra staff (admin claim) write the price table and
// the contracts. The app may only write its own profile, its devices and
// feedback. Plans are never checked here: the rules decide who can reach a
// farm, not what it pays for.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Custom claim on Wafra staff accounts.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // farmAccess/{uid}_{farmId}
    function accessPath(farmId) {
      return /databases/$(database)/documents/farmAccess/$(request.auth.uid + '_' + farmId);
    }

    function hasAccess(farmId) {
      return signedIn() && exists(accessPath(farmId))
        && get(accessPath(farmId)).data.status == 'active';
    }

    function isOwnerLike(farmId) {
      return hasAccess(farmId)
        && get(accessPath(farmId)).data.role in ['owner', 'co-owner'];
    }

    // -- people ---------------------------------------------------------------

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['firstName', 'lastName', 'email', 'phone', 'preferences', 'createdAt', 'updatedAt'])
        && request.resource.data.phone == request.auth.token.phone_number;

      // contract, mmcUserId, lastActiveAt and syncedAt belong to the server.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'email', 'preferences', 'updatedAt']);

      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // -- prices and contracts -------------------------------------------------

    // The price table. The app prices farms from it.
    match /pricing/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Deals paid by invoice. Staff only.
    match /contracts/{contractId} {
      allow read, write: if isAdmin();
    }

    // Contract farms, keyed by the owner's E.164 phone number. A person can
    // fetch only their own entry, by their verified phone; nobody can list.
    match /contractFarms/{phone} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.token.phone_number == phone);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /farmAccess/{accessId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || isOwnerLike(resource.data.farmId);
      allow write: if false;
    }

    // -- farms --------------------------------------------------------------

    match /farms/{farmId} {
      // Includes `plan`: who pays for the farm and what it may use (written by MMC).
      allow read: if isAdmin() || hasAccess(farmId);
      allow write: if false;

      match /contacts/{contactId} {
        allow read: if isAdmin() || isOwnerLike(farmId);
        allow write: if false;
      }
    }

    // -- feedback -----------------------------------------------------------

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'farmId', 'type', 'message', 'appVersion', 'platform', 'lang', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && (!('farmId' in request.resource.data) || hasAccess(request.resource.data.farmId))
        && request.resource.data.type in ['bug', 'idea', 'question']
        && request.resource.data.status == 'new'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin();
      allow delete: if false;
    }

    // -- suggestions log ----------------------------------------------------

    match /suggestions/{suggestionId} {
      allow read: if isAdmin() || hasAccess(resource.data.farmId);
      allow write: if false;

      match /shares/{shareId} {
        allow read: if isAdmin() || hasAccess(resource.data.farmId);
        allow write: if false;
      }
    }
  }
}
